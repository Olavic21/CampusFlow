POSTGRES_USER=campusflow
POSTGRES_PASSWORD=securepass
POSTGRES_DB=campusflow

# --- Développement local (PostgreSQL + Redis sur localhost) ---
DATABASE_URL=postgresql://campusflow:securepass@localhost:5432/campusflow
SQLALCHEMY_DATABASE_URL=postgresql://campusflow:securepass@localhost:5432/campusflow
REDIS_URL=redis://localhost:6379/0
ML_MODEL_PATH=../ml/model.pkl
CORS_ORIGINS=http://localhost:5173

