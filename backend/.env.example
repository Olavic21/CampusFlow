POSTGRES_USER=campusflow
POSTGRES_PASSWORD=securepass
POSTGRES_DB=campusflow

# --- Développement local rapide (SQLite, sans Docker) ---
DATABASE_URL=sqlite:///./campusflow.db
SQLALCHEMY_DATABASE_URL=sqlite:///./campusflow.db
REDIS_URL=redis://localhost:6379/0
ML_MODEL_PATH=../ml/model.pkl
# Web dev + Capacitor APK (https://localhost)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
# Pour APK : lancer uvicorn avec --host 0.0.0.0 (voir scripts/restart-backend.ps1 -Lan)

# JWT (changer en production)
JWT_SECRET=change-me-use-long-random-string-in-production
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Médias (avatars)
MEDIA_ROOT=../media
MEDIA_URL=/media

# IoT / Capteurs — simulation | api | mqtt | websocket
SENSOR_MODE=simulation
SENSOR_SIM_INTERVAL_SEC=10
# CAPTEURS_JSON_PATH=../data/raw/capteurs.json
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_TOPIC=campusflow/occupancy/#

# --- Production PostgreSQL (décommenter) ---
# DATABASE_URL=postgresql://campusflow:securepass@localhost:5432/campusflow
# SQLALCHEMY_DATABASE_URL=postgresql://campusflow:securepass@localhost:5432/campusflow
