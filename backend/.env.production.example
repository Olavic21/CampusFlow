# ─────────────────────────────────────────────────────────────────────────────
# CampusFlow — backend en PRODUCTION (Oracle Cloud)
#
# Ce fichier est un GABARIT committable : il ne contient AUCUN secret réel.
# Sur la VM : copier vers backend/.env (fichier ignoré par Git) puis remplacer
# toutes les valeurs <...>. Utiliser setup-vm.sh qui génère ce fichier.
#
#   sudo cp backend/.env.production.example backend/.env
#   sudo nano backend/.env
#   sudo chmod 600 backend/.env            # lisible seulement par le service
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL + PostGIS, sur la même VM) ───────────────────
# Format : postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/<DB_NAME>
DATABASE_URL=postgresql://campusflow:<DB_PASSWORD>@127.0.0.1:5432/campusflow

# ── Cache (optionnel — fallback gracieux si absent) ──────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── CORS : origines frontend autorisées (séparées par des virgules) ──────────
# Doit contenir le domaine Vercel de PRODUCTION (sans slash final).
CORS_ORIGINS=https://<PROJECT>.vercel.app
# OPTIONNEL — à n'utiliser que si vous déployez aussi des previews Vercel.
# Exemple : https://.*\.vercel\.app  (attention : autorise TOUS les domaines vercel.app)
CORS_ORIGIN_REGEX=

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# 32+ caractères aléatoires : openssl rand -hex 32
JWT_SECRET=<JWT_SECRET>
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
BCRYPT_ROUNDS=10

# ── Médias (avatars) — servis par l'API sous /media ──────────────────────────
MEDIA_ROOT=/var/lib/campusflow/media
MEDIA_URL=/media
AVATAR_MAX_UPLOAD_BYTES=5242880

# URL publique de l'API (utilisée pour construire des liens absolus)
PUBLIC_API_BASE=https://<API_DOMAIN>

# ── Modèle ML (facultatif : /predict renvoie 503 si absent) ──────────────────
ML_MODEL_PATH=/opt/campusflow/ml/model.pkl

# ── IoT / Capteurs — simulation | api | mqtt | websocket | hybrid ────────────
SENSOR_MODE=simulation
SENSOR_SIM_INTERVAL_SEC=10
CAPTEURS_JSON_PATH=/opt/campusflow/data/raw/capteurs.json
# MQTT_BROKER_URL=mqtt://127.0.0.1:1883
# MQTT_TOPIC=campusflow/occupancy/#

# ── Qualité des données / rétention ──────────────────────────────────────────
STALE_AFTER_SEC=120
SENSOR_HEARTBEAT_OFFLINE_SEC=90
RETENTION_DAYS=90
