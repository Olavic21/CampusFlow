# CampusFlow Lite - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer .env dans Git !

DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusflow
DB_USER=postgres
# ROTATION 2026-09-21 : l'ancienne valeur (secret reel) a ete purgee de git par filter-repo.
# Aucun mot de passe reel ne doit figurer ici. S'il en faut un, utiliser la variable
# DATABASE_URL complete (qui remplace DB_HOST/PORT/NAME/USER/PASSWORD quand elle est definie).
DB_PASSWORD=CHANGER_VOTRE_SECRET
