# ─────────────────────────────────────────────────────────────────────────────
# CampusFlow — service systemd du backend FastAPI (Oracle Cloud VM)
# Installation : sudo cp deploy/oracle/campusflow-api.service /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now campusflow-api
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=CampusFlow API (FastAPI / Uvicorn)
Documentation=https://github.com/nkoumougrinnel/CampusFlow
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=campusflow
Group=campusflow
WorkingDirectory=/opt/campusflow/backend

# Secrets et configuration — fichier NON versionné (chmod 600)
EnvironmentFile=/opt/campusflow/backend/.env

# --workers 1 : obligatoire. Le simulateur de capteurs et le hub WebSocket
# tiennent un état en mémoire ; plusieurs workers dupliqueraient ces états.
# --proxy-headers : l'IP et le schéma réels (https) viennent de Nginx.
ExecStart=/opt/campusflow/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

# Redémarrage automatique en cas de crash
Restart=always
RestartSec=5
StartLimitBurst=10
StartLimitIntervalSec=300

# Logs : journald (journalctl -u campusflow-api)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=campusflow-api

# ── Sécurité minimale du processus ───────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/campusflow

[Install]
WantedBy=multi-user.target
