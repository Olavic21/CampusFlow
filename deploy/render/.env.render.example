# Chemin SQLite explicite pour Render (défaut : chemin relatif local).
# Sur Render : /data/campusflow.db (Disk monté sur /data — voir deploy/render/)
# ATTENTION : sur Render Free, le système de fichiers local N'EST PAS durable ;
# les données peuvent être perdues lors d'un redéploiement/replacement.
# Sur Render : DATABASE_URL=sqlite:////data/campusflow.db (4 slashes = chemin absolu)
DATABASE_URL=sqlite:////data/campusflow.db
MEDIA_ROOT=/data/media
PUBLIC_API_BASE=https://campusflow-api.onrender.com
JWT_SECRET=<SECRET-64-CARACTERES-A-GENERER-NE-JAMAIS-COMMITTER>
CORS_ORIGINS=https://<projet>.vercel.app
SENSOR_MODE=simulation
SENSOR_SIM_INTERVAL_SEC=10
CAPTEURS_JSON_PATH=../data/raw/capteurs.json