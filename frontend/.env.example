# URL de l'API backend (via proxy Vite en dev)
VITE_API_URL=/api

# Source de données capteurs côté frontend :
# api        → /flux/live (recommandé — backend gère simulation ou capteurs réels)
# simulation → capteurs.json local (hors ligne)
# websocket  → /ws/live-occupancy/ + fallback API
VITE_SENSOR_MODE=api

# WebSocket direct (optionnel — sinon proxy Vite /ws)
# VITE_WS_URL=ws://127.0.0.1:8000

# APK Android — IP LAN du PC (ipconfig → Ethernet active, ex. 10.26.124.130)
# VITE_BACKEND_DIRECT=http://10.26.124.130:8000
# VITE_API_URL=http://10.26.124.130:8000
# VITE_WS_URL=ws://10.26.124.130:8000
# Fichier prêt : copier .env.apk → .env avant cap:sync

# Développement : contourner l'écran de connexion
# VITE_SKIP_AUTH=true
