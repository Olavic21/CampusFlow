# ─────────────────────────────────────────────────────────────────────────────
# CampusFlow — frontend en PRODUCTION (Vercel)
#
# Ce fichier est un GABARIT committable (aucun secret : uniquement des URLs).
# Sur Vercel : Settings → Environment Variables (Production) et renseigner :
#   VITE_API_URL        https://<API_DOMAIN>
#   VITE_WS_URL         wss://<API_DOMAIN>
#   VITE_BACKEND_DIRECT https://<API_DOMAIN>
#   VITE_SENSOR_MODE    api
#
# Ne PAS définir VITE_API_URL=/api sur Vercel : /api n'existe pas côté Vercel
# (le proxy /api → 127.0.0.1:8000 n'existe qu'en développement via vite.config.js).
# ─────────────────────────────────────────────────────────────────────────────

# API backend (Oracle Cloud, HTTPS obligatoire : une page HTTPS ne peut pas
# appeler une API HTTP — contenu mixte bloqué par le navigateur).
VITE_API_URL=https://<API_DOMAIN>

# WebSocket temps réel (/ws/live-occupancy/)
VITE_WS_URL=wss://<API_DOMAIN>

# Base des médias (avatars) — évite toute référence à 127.0.0.1 en production
VITE_BACKEND_DIRECT=https://<API_DOMAIN>

# Source des données capteurs côté frontend : api | simulation | websocket
VITE_SENSOR_MODE=api

# NE PAS activer en production (contournement de l'écran de connexion)
# VITE_SKIP_AUTH=true
